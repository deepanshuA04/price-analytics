# Copy to .env and adjust if needed. Nothing here is secret for this project
# (the data source requires no API key) but the collector reads config from
# the environment so nothing is hardcoded, and so a future source swap that
# does need a key drops in without a code change.

COLLECTOR_BASE_URL=https://books.toscrape.com
COLLECTOR_USER_AGENT=price-analytics-bot/0.1 (+https://github.com/deepanshuA04/price-analytics)
COLLECTOR_REQUEST_DELAY_SECONDS=1.0
COLLECTOR_MAX_RETRIES=5

# Seeds the per-SKU random-walk price drift (see README > Data source) so runs
# are reproducible.
PRICE_DRIFT_SEED=20260811
